# 服务端监听地址
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# SQLite 与附件数据目录（相对项目根目录）
DATA_DIR=./data

# DeepSeek 服务端 Key：只保存在服务器，不下发浏览器
DEEPSEEK_API_KEY=
# API 服务根地址：必须提供 Anthropic 兼容的 Messages / Files 接口
# 不要以 /v1 结尾；服务端会拼接 /anthropic/v1/messages 和 /v1/tools/*
# 仅提供 OpenAI 兼容接口的第三方网关不能直接使用
DEEPSEEK_API_ORIGIN=https://api.deepseek.com

# 登录 Cookie
SESSION_TTL_DAYS=30
# 通过 HTTPS 访问时必须为 true
COOKIE_SECURE=true
# 在 Nginx/Caddy 反向代理后运行时设为 true
TRUST_PROXY=true

# 注册默认关闭，用 pnpm server:user add 创建账号
ALLOW_REGISTRATION=false
REGISTRATION_CODE=

# 大小与配额限制（MB）
MAX_SESSION_MB=32
MAX_FILE_MB=64
MAX_IMPORT_MB=512
MAX_IMPORT_UNCOMPRESSED_MB=2048
MAX_USER_STORAGE_MB=2048

# 每个用户每分钟最多请求 AI 接口的次数
AI_REQUESTS_PER_MINUTE=30
# 登录尝试限流
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MINUTES=10
