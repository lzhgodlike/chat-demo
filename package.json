{
  "name": "chat-demo",
  "version": "0.1.3",
  "description": "基于 DeepSeek API 的聊天应用示例，支持静态部署与多用户服务器端会话存储。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "dev:web": "cross-env SERVER_MODE=1 rspack serve -c rspack.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && cross-env NODE_ENV=production rspack build -c rspack.config.ts",
    "build:server": "node scripts/clean.mjs && cross-env SERVER_MODE=1 NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json && tsc -p server/tsconfig.json && tsc -p server/tsconfig.test.json",
    "lint": "oxlint src server rspack.config.ts",
    "format": "oxfmt --write .",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/server/src/index.js",
    "server:user": "tsx server/src/cli/user.ts",
    "test:server": "tsx --test server/test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.12",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "better-sqlite3": "^13.2.0",
    "clsx": "2.1.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
